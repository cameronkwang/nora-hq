# Nora HQ — environment variables. Copy to .env.local for local dev; set the same names in
# Vercel → Project → Settings → Environment Variables for production. See docs/setup.md.
# Local dev works with none of these set (embedded database, password "dev"). Delete any line you
# leave blank in .env.local — an empty value counts as "set" for some of them.

# ── Core ──────────────────────────────────────────────────────────────
# Neon Postgres connection string. Added automatically by the Vercel Marketplace Neon integration.
# Leave unset locally to use the embedded PGlite database in ./.data
DATABASE_URL=
# Signs sign-in sessions and OAuth state. Generate: openssl rand -base64 32
AUTH_SECRET=
# Shared sign-in password for Cameron and Nora. Make it long.
APP_PASSWORD=
# Who can sign in: Name:email pairs, comma separated.
APP_USERS=Cameron:cameron@example.com,Nora:nora@example.com
# Public URL, no trailing slash. Used for OAuth redirect URIs and the Claude connector URL.
APP_URL=https://ops.cameronwang.com
# Encrypts Instagram/Google tokens at rest. 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENC_KEY=
# Timezone for "this month" and due dates.
APP_TZ=America/New_York
# Vercel Blob token for photo/video uploads (added when you create a Blob store). Needed for Instagram auto-publish.
BLOB_READ_WRITE_TOKEN=
# Email new clients add as a helper on their Facebook/Instagram/Google accounts (shown in the client onboarding form at /start/<token>).
# Optional: without it the form says "Nora's email — we'll text it to you".
INTAKE_ACCESS_EMAIL=

# ── Claude connector ──────────────────────────────────────────────────
# Bearer token Claude sends to /api/mcp. Generate: openssl rand -hex 32
MCP_TOKEN=

# ── Scheduled jobs ────────────────────────────────────────────────────
# Protects /api/cron/*. Vercel Cron sends it automatically; also add it as a GitHub Actions secret.
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Instagram (Meta app, "Instagram API with Instagram Login") ────────
IG_APP_ID=
IG_APP_SECRET=
# Optional: Graph API version (default v24.0). Bump when Meta retires the default.
IG_API_VERSION=

# ── Google (Business Profile + Gmail share one OAuth client) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Outreach email ────────────────────────────────────────────────────
# Sender name shown on outreach emails (defaults to the part of the Gmail address before @).
OUTREACH_FROM_NAME=
# Optional custom footer added to every outreach email. Use \n for line breaks and {sender} for the
# sender name. Keep an opt-out line and add a postal address (CAN-SPAM). Default:
#   --\n{sender}\nNot interested? Just reply 'stop' and we won't email again.
OUTREACH_FOOTER=

# ── TikTok (Nora's own @noraeatsgood stats; Login Kit v2 + Display API) ──
# developers.tiktok.com → your app → Client key / Client secret. See docs/setup.md, step 10.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Phone notifications (Web Push) ────────────────────────────────────
# Generate once: npx web-push generate-vapid-keys  (keep the private key secret; changing keys
# means everyone turns notifications on again). See docs/notifications.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or your https APP_URL (not localhost).
VAPID_SUBJECT=
